    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839176
    m_Localized: "\u0420\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839177
    m_Localized: "\u0412\u044B \u0443\u0432\u0435\u0440\u0435\u043D\u044B, \u0447\u0442\u043E
      \u0445\u043E\u0442\u0438\u0442\u0435 \u0440\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u044D\u0442\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839178
    m_Localized: "\u043E\u0442\u043C\u0435\u043D\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839179
    m_Localized: "\u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839180
    m_Localized: "\u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839181
    m_Localized: "\u043C\u0443\u0437\u044B\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839182
    m_Localized: "\u0437\u0432\u0443\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839183
    m_Localized: "\u0441\u043B\u0443\u0447\u0430\u0439\u043D\u0430\u044F \u0440\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839184
    m_Localized: "\u044F\u0437\u044B\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839185
    m_Localized: "\u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839186
    m_Localized: "\u0432\u044B\u0431\u043E\u0440 \u0444\u0438\u0448\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839187
    m_Localized: "\u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u0432\u043E\u0439
      \u0446\u0432\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839188
    m_Localized: "\u043A\u0430\u043A \u0438\u0433\u0440\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839189
    m_Localized: "\u0421\u0438\u0434\u0436\u0430 \u2014 \u0441\u0442\u0430\u0440\u0438\u043D\u043D\u0430\u044F
      \u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043D\u0430\u044F
      \u0438\u0433\u0440\u0430 \u0434\u043B\u044F \u0434\u0432\u0443\u0445 \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u043E\u0432,
      \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0430
      \u043D\u0430 \u0441\u0435\u0432\u0435\u0440\u043E-\u0432\u043E\u0441\u0442\u043E\u043A\u0435
      \u0410\u0444\u0440\u0438\u043A\u0438 \u0438 \u0432 \u0421\u0430\u0443\u0434\u043E\u0432\u0441\u043A\u043E\u0439
      \u0410\u0440\u0430\u0432\u0438\u0438. \u0418\u0433\u0440\u0430\u044E\u0442
      \u0434\u0432\u043E\u0435. \u0423 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u0438\u0433\u0440\u043E\u043A\u0430 \u043F\u043E 12 \u0444\u0438\u0448\u0435\u043A.
      \u0426\u0435\u043B\u044C \u0438\u0433\u0440\u044B: \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u0442\u044C
      \u043D\u0435 \u043C\u0435\u043D\u0435\u0435 11 \u0444\u0438\u0448\u0435\u043A
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839190
    m_Localized: "\u0418\u0433\u0440\u0430 \u0438\u0434\u0451\u0442 \u0432 \u0434\u0432\u0435
      \u0444\u0430\u0437\u044B. \u041F\u0435\u0440\u0432\u0430\u044F \u0444\u0430\u0437\u0430:
      \u0440\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430. \u0418\u0433\u0440\u043E\u043A\u0438
      \u043F\u043E\u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u0432\u044B\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442
      \u043F\u043E \u0434\u0432\u0435 \u0444\u0438\u0448\u043A\u0438 \u043D\u0430
      \u043B\u044E\u0431\u044B\u0435 \u0434\u0432\u0435 \u043A\u043B\u0435\u0442\u043A\u0438
      \u043F\u043E\u043B\u044F, \u043A\u0440\u043E\u043C\u0435 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839191
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0440\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u0432\u0442\u043E\u0440\u0430\u044F
      \u0444\u0430\u0437\u0430: \u0441\u0440\u0430\u0436\u0435\u043D\u0438\u0435.
      \u0418\u0433\u0440\u043E\u043A, \u043D\u0430\u0447\u0430\u0432\u0448\u0438\u0439
      \u0440\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443, \u0434\u0435\u043B\u0430\u0435\u0442
      \u0438 \u043F\u0435\u0440\u0432\u044B\u0439 \u0445\u043E\u0434 \u0432 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u0443\u044E
      \u043A\u043B\u0435\u0442\u043A\u0443.  \u0424\u0438\u0448\u043A\u0430 \u0445\u043E\u0434\u0438\u0442
      \u0432 \u043B\u044E\u0431\u043E\u043C \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438
      (\u0432 \u0442\u043E\u043C \u0447\u0438\u0441\u043B\u0435 \u0438 \u043F\u043E
      \u0434\u0438\u0430\u0433\u043E\u043D\u0430\u043B\u0438) \u043D\u0430 \u043E\u0434\u043D\u0443
      \u043A\u043B\u0435\u0442\u043A\u0443, \u0435\u0441\u043B\u0438 \u043E\u043D\u0430
      \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u0430. \u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      \u0445\u043E\u0434 \u043D\u0435\u043B\u044C\u0437\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839192
    m_Localized: "\u0415\u0441\u043B\u0438 \u043F\u043E\u0441\u043B\u0435 \u0445\u043E\u0434\u0430
      \u0444\u0438\u0448\u043A\u0430 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430
      \u043F\u043E\u043F\u0430\u043B\u0430 \u043C\u0435\u0436\u0434\u0443 \u0434\u0432\u0443\u043C\u044F
      \u0444\u0438\u0448\u043A\u0430\u043C\u0438 \u0445\u043E\u0434\u044F\u0449\u0435\u0433\u043E
      \u0438\u0433\u0440\u043E\u043A\u0430, \u0442\u043E \u043E\u043D \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
      \u0437\u0430\u0445\u0432\u0430\u0447\u0435\u043D\u043D\u044B\u043C \u0438 \u0443\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F
      \u0441 \u043F\u043E\u043B\u044F.  \u041F\u0440\u0438\u0447\u0451\u043C \u0437\u0430\u0445\u0432\u0430\u0447\u0435\u043D\u043D\u044B\u043C\u0438
      \u0441\u0447\u0438\u0442\u0430\u044E\u0442\u0441\u044F \u0441\u0440\u0430\u0437\u0443
      \u0432\u0441\u0435 \u0444\u0438\u0448\u043A\u0438 \u043F\u043E \u0432\u0441\u0435\u043C
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F\u043C (\u043F\u043E
      \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u0438, \u043F\u043E \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u0438
      \u0438 \u043F\u043E \u0434\u0438\u0430\u0433\u043E\u043D\u0430\u043B\u044F\u043C). "
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839193
    m_Localized: "\u0424\u0438\u0448\u043A\u0438, \u0438\u0437\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E
      \u0437\u0430\u0436\u0430\u0442\u044B\u0435, \u043C\u0435\u0436\u0434\u0443
      \u0444\u0438\u0448\u043A\u0430\u043C\u0438 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430
      \u043D\u0435 \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0437\u0430\u0445\u0432\u0430\u0447\u0435\u043D\u043D\u044B\u043C\u0438,
      \u0442\u0430\u043A \u0436\u0435 \u043A\u0430\u043A \u0438 \u0441\u0432\u043E\u044F
      \u0444\u0438\u0448\u043A\u0430, \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u0430\u044F
      \u0438\u0433\u0440\u043E\u043A\u043E\u043C \u043C\u0435\u0436\u0434\u0443 \u0434\u0432\u0443\u043C\u044F
      \u0444\u0438\u0448\u043A\u0430\u043C\u0438 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430. "
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839194
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u043D\u0430 \u043F\u043E\u043B\u0435
      \u0443 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u043C\u0435\u043D\u044C\u0448\u0435 \u0434\u0432\u0443\u0445 \u0444\u0438\u0448\u0435\u043A,
      \u0437\u0430\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043F\u043E\u0431\u0435\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839195
    m_Localized: "\u0434\u0430\u043B\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839196
    m_Localized: "\u043F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u044E!"
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839197
    m_Localized: "\u0432\u044B \u043F\u043E\u0431\u0435\u0434\u0438\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839198
    m_Localized: "\u0445\u043E\u0440\u043E\u0448\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839199
    m_Localized: "\u0438\u0433\u0440\u0430 \u043E\u043A\u043E\u043D\u0447\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839200
    m_Localized: "\u0443\u0432\u044B, \u0432\u044B \u043F\u0440\u043E\u0438\u0433\u0440\u0430\u043B\u0438,
      \u043F\u043E\u0432\u0435\u0437\u0451\u0442 \u0432 \u0434\u0440\u0443\u0433\u043E\u0439
      \u0440\u0430\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839201
    m_Localized: "\u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u0432 \u043C\u0435\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839202
    m_Localized: "\u0438\u0433\u0440\u0430 \u043D\u0430\u0447\u0430\u043B\u0430\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839203
    m_Localized: "\u0432\u0430\u0448 \u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839204
    m_Localized: "\u0445\u043E\u0434 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839205
    m_Localized: "\u0432\u0430\u0448 \u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839206
    m_Localized: "\u0438\u0433\u0440\u0430 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0430\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839207
    m_Localized: "\u0420\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430
      \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0430! \u0422\u0435\u043F\u0435\u0440\u044C
      \u0441\u044B\u0433\u0440\u0430\u0435\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 7280575996588032
    m_Localized: "\u0418\u0433\u0440\u0430 \u043D\u0430\u0447\u0430\u043B\u0430\u0441\u044C!
      \u0420\u0430\u0441\u0441\u0442\u0430\u0432\u0438\u043C \u0444\u0438\u0448\u043A\u0438"
    m_Metadata:
