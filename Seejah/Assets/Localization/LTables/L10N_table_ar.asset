  - m_Id: 7254476872839186
    m_Localized: "\u0627\u062E\u062A\u064A\u0627\u0631 \u0631\u0642\u0627\u0642\u0629"
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839187
    m_Localized: "\u0627\u062E\u062A\u0631 \u0627\u0644\u0644\u0648\u0646 \u0627\u0644\u062E\u0627\u0635
      \u0628\u0643"
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839188
    m_Localized: "\u0643\u064A\u0641 \u0623\u0644\u0639\u0628"
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839189
    m_Localized: "\u0633\u064A\u062C\u0627 \u0647\u064A \u0644\u0639\u0628\u0629
      \u0644\u0648\u062D\u064A\u0629 \u0645\u0646\u0637\u0642\u064A\u0629 \u0642\u062F\u064A\u0645\u0629
      \u0644\u0644\u0627\u0639\u0628\u064A\u0646\u060C \u0648\u0647\u064A \u0634\u0627\u0626\u0639\u0629
      \u0641\u064A \u0634\u0645\u0627\u0644 \u0634\u0631\u0642 \u0625\u0641\u0631\u064A\u0642\u064A\u0627
      \u0648\u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u0639\u0631\u0628\u064A\u0629
      \u0627\u0644\u0633\u0639\u0648\u062F\u064A\u0629. \u0634\u062E\u0635\u0627\u0646
      \u064A\u0644\u0639\u0628\u0627\u0646. \u0643\u0644 \u0644\u0627\u0639\u0628
      \u0644\u062F\u064A\u0647 12 \u0634\u0631\u064A\u062D\u0629. \u0627\u0644\u0647\u062F\u0641
      \u0645\u0646 \u0627\u0644\u0644\u0639\u0628\u0629 \u0647\u0648 \u0627\u0644\u0627\u0633\u062A\u064A\u0644\u0627\u0621
      \u0639\u0644\u0649 11 \u0642\u0637\u0639\u0629 \u0644\u0644\u0639\u062F\u0648
      \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644."
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839190
    m_Localized: "\u062A\u062C\u0631\u064A \u0627\u0644\u0644\u0639\u0628\u0629 \u0639\u0644\u0649
      \u0645\u0631\u062D\u0644\u062A\u064A\u0646. \u0627\u0644\u0645\u0631\u062D\u0644\u0629
      \u0627\u0644\u0623\u0648\u0644\u0649: \u0627\u0644\u062A\u0631\u062A\u064A\u0628.
      \u064A\u0642\u0648\u0645 \u0627\u0644\u0644\u0627\u0639\u0628\u0648\u0646 \u0628\u0648\u0636\u0639
      \u0642\u0637\u0639\u062A\u064A\u0646 \u0628\u0627\u0644\u062A\u0646\u0627\u0648\u0628
      \u0639\u0644\u0649 \u0623\u064A \u0645\u0631\u0628\u0639\u064A\u0646 \u0645\u0646
      \u0627\u0644\u0645\u0644\u0639\u0628\u060C \u0628\u0627\u0633\u062A\u062B\u0646\u0627\u0621
      \u0627\u0644\u0645\u0631\u0628\u0639 \u0627\u0644\u0645\u0631\u0643\u0632\u064A."
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839191
    m_Localized: "\u0628\u0639\u062F \u0627\u0644\u062A\u0646\u0633\u064A\u0628 \u060C
      \u062A\u0628\u062F\u0623 \u0627\u0644\u0645\u0631\u062D\u0644\u0629 \u0627\u0644\u062B\u0627\u0646\u064A\u0629:
      \u0627\u0644\u0645\u0639\u0631\u0643\u0629. \u064A\u0642\u0648\u0645 \u0627\u0644\u0644\u0627\u0639\u0628
      \u0627\u0644\u0630\u064A \u0628\u062F\u0623 \u0627\u0644\u062A\u0646\u0633\u064A\u0628
      \u0623\u064A\u0636\u0627 \u0628\u0627\u0644\u062E\u0637\u0648\u0629 \u0627\u0644\u0623\u0648\u0644\u0649
      \u0625\u0644\u0649 \u0627\u0644\u0633\u0627\u062D\u0629 \u0627\u0644\u0645\u0631\u0643\u0632\u064A\u0629. 
      \u062A\u062A\u062D\u0631\u0643 \u0627\u0644\u0634\u0631\u064A\u062D\u0629 \u0641\u064A
      \u0623\u064A \u0627\u062A\u062C\u0627\u0647 (\u0628\u0645\u0627 \u0641\u064A
      \u0630\u0644\u0643 \u0642\u0637\u0631\u064A\u0627) \u0645\u0631\u0628\u0639
      \u0648\u0627\u062D\u062F \u0625\u0630\u0627 \u0643\u0627\u0646\u062A \u0645\u062C\u0627\u0646\u064A\u0629.
      \u0644\u0627 \u064A\u0645\u0643\u0646\u0643 \u062A\u062E\u0637\u064A \u0647\u0630\u0647
      \u0627\u0644\u062E\u0637\u0648\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839192
    m_Localized: "\u0625\u0630\u0627 \u0633\u0642\u0637\u062A \u0642\u0637\u0639\u0629
      \u0627\u0644\u062E\u0635\u0645 \u0628\u064A\u0646 \u0642\u0637\u0639\u062A\u064A\u0646
      \u0645\u0646 \u0627\u0644\u0644\u0627\u0639\u0628 \u0627\u0644\u0630\u064A
      \u064A\u0645\u0634\u064A\u060C \u0628\u0639\u062F \u0627\u0644\u0646\u0642\u0644\u0629\u060C
      \u0641\u0625\u0646\u0647 \u064A\u0639\u062A\u0628\u0631 \u0645\u0623\u0633\u0648\u0631\u064B\u0627
      \u0648\u064A\u062A\u0645 \u0625\u0632\u0627\u0644\u062A\u0647 \u0645\u0646
      \u0627\u0644\u0645\u0644\u0639\u0628. \u0639\u0644\u0627\u0648\u0629 \u0639\u0644\u0649
      \u0630\u0644\u0643\u060C \u062A\u0639\u062A\u0628\u0631 \u062C\u0645\u064A\u0639
      \u0627\u0644\u0631\u0642\u0627\u0626\u0642 \u0641\u064A \u062C\u0645\u064A\u0639
      \u0627\u0644\u0627\u062A\u062C\u0627\u0647\u0627\u062A (\u0639\u0645\u0648\u062F\u064A\u064B\u0627
      \u0648\u0623\u0641\u0642\u064A\u064B\u0627 \u0648\u0642\u0637\u0631\u064A\u064B\u0627)
      \u0645\u0644\u062A\u0642\u0637\u0629 \u0645\u0631\u0629 \u0648\u0627\u062D\u062F\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839193
    m_Localized: "\u0644\u0627 \u064A\u062A\u0645 \u0627\u0644\u062A\u0642\u0627\u0637
      \u0627\u0644\u0631\u0642\u0627\u0626\u0642 \u0627\u0644\u062A\u064A \u062A\u0645
      \u0648\u0636\u0639\u0647\u0627 \u0641\u064A \u0627\u0644\u0628\u062F\u0627\u064A\u0629
      \u0628\u064A\u0646 \u0642\u0637\u0639 \u0627\u0644\u062E\u0635\u0645\u060C
      \u062A\u0645\u0627\u0645\u064B\u0627 \u0645\u062B\u0644 \u0627\u0644\u0631\u0642\u0627\u0642\u0629
      \u0627\u0644\u062A\u064A \u064A\u0636\u0639\u0647\u0627 \u0627\u0644\u0644\u0627\u0639\u0628
      \u0628\u064A\u0646 \u0642\u0637\u0639\u062A\u064A\u0646 \u0644\u0644\u0639\u062F\u0648."
    m_Metadata:
      m_Items: []
  - m_Id: 7254476872839194
    m_Localized: "\u0639\u0646\u062F\u0645\u0627 \u064A\u0643\u0648\u0646 \u0644\u062F\u0649
      \u0627\u0644\u062E\u0635\u0645 \u0623\u0642\u0644 \u0645\u0646 \u0642\u0637\u0639\u062A\u064A\u0646
      \u0645\u062A\u0628\u0642\u064A\u062A\u064A\u0646 \u0639\u0644\u0649 \u0623\u0631\u0636
      \u0627\u0644\u0645\u0644\u0639\u0628\u060C \u064A\u062A\u0645 \u0627\u062D\u062A\u0633\u0627\u0628
      \u0627\u0644\u0646\u0635\u0631."
    m_Metadata:
      m_Items: []
